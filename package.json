{
  "name": "satri-dr-panel",
  "version": "0.1.0",
  "description": "Painel local de backup e disaster recovery da Intranet SATRI",
  "main": "dist-electron/main.js",
  "author": "Daniel Marchezini",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "build:dir": "tsc -b && vite build && electron-builder --dir",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p electron -w\" \"wait-on tcp:5173 dist-electron/main.js && electron .\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "@aws-sdk/client-s3": "^3.632.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.satri.drpanel",
    "productName": "SATRI DR Panel",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "extraResources": [{ "from": "resources", "to": "." }],
    "win": { "target": "nsis" }
  }
}
